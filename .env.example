# .env.example — placeholders only
LLM_PROVIDER=groq
# For local inference set LLM_PROVIDER=ollama; no API key is needed.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
GROQ_API_KEY=replace_with_your_own_key
MODEL_NAME=llama-3.3-70b-versatile

# Optional alternative providers
GEMINI_API_KEY=replace_with_your_gemini_key
OPENAI_API_KEY=replace_with_your_openai_key

# Email OTP sign-in (required for hosted registration/login)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=InterviewIQ <no-reply@example.com>
# Set a long random secret in deployment settings; do not commit real secrets.
OTP_SIGNING_SECRET=replace_with_a_long_random_secret
